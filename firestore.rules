rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDeck(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function validDeck(data) {
      return data.keys().hasAll([
          'ownerUid', 'ownerName', 'name', 'isPublic',
          'cards', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerName', 'name', 'isPublic',
          'cards', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerName is string
        && data.ownerName.size() <= 50
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.isPublic is bool
        && data.cards is list
        && data.cards.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /decks/{deckId} {
      // Public decks may be read by anyone. Private decks are owner-only.
      allow get, list: if resource.data.isPublic == true
        || ownsDeck(resource.data.ownerUid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validDeck(request.resource.data);

      allow update: if ownsDeck(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && validDeck(request.resource.data);

      allow delete: if ownsDeck(resource.data.ownerUid);
    }
  }
}
