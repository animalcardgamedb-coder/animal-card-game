rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDeck(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function validNewDeck(data) {
      return data.keys().hasAll([
          'ownerUid', 'ownerName', 'name', 'isPublic',
          'cards', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'ownerName', 'name', 'isPublic',
          'cards', 'createdAt', 'updatedAt', 'tags', 'territoryCards'
        ])
        && data.ownerUid is string
        && data.ownerName is string
        && data.ownerName.size() <= 50
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.isPublic is bool
        && data.cards is list
        && data.cards.size() <= 200
        && (!data.keys().hasAny(['territoryCards']) || (data.territoryCards is list && data.territoryCards.size() <= 200))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['tags'])
          || (data.tags is list && data.tags.size() <= 12));
    }

    function validDeckUpdate(data) {
      // Only allow owners to edit supported fields, while leaving legacy fields intact.
      // Older decks may have additional fields, so updates should not reject them.
      return data.keys().hasAll([
          'ownerUid', 'name', 'isPublic', 'cards', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 50
        && data.isPublic is bool
        && data.cards is list
        && data.cards.size() <= 200
        && (!data.keys().hasAny(['territoryCards']) || (data.territoryCards is list && data.territoryCards.size() <= 200))
        && data.updatedAt is timestamp
        && (!data.keys().hasAny(['tags'])
          || (data.tags is list && data.tags.size() <= 12));
    }

    match /decks/{deckId} {
      // Public decks may be read by anyone. Private decks are owner-only.
      allow get, list: if resource.data.isPublic == true
        || ownsDeck(resource.data.ownerUid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validNewDeck(request.resource.data);

      allow update: if ownsDeck(resource.data.ownerUid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'isPublic', 'cards', 'territoryCards', 'tags', 'updatedAt'
        ])
        && validDeckUpdate(request.resource.data);

      allow delete: if ownsDeck(resource.data.ownerUid);
    }

    match /deckTagCatalog/{tagId} {
      // All users may read the shared tag catalogue; signed-in users may only add tags.
      allow get, list: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['name', 'normalized', 'createdAt', 'createdByUid'])
        && request.resource.data.keys().hasOnly(['name', 'normalized', 'createdAt', 'createdByUid'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.normalized is string
        && request.resource.data.normalized.size() > 0
        && request.resource.data.normalized.size() <= 24
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['deckTags', 'updatedAt'])
        && request.resource.data.deckTags is list
        && request.resource.data.deckTags.size() <= 12
        && request.resource.data.updatedAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
